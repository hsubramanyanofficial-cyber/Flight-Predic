{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with travel preferences and alert configurations.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth user identifier."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User full name."
        },
        "homeAirport": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "3-letter IATA code of home base airport."
        },
        "preferredAirlines": {
          "type": "array",
          "description": "List of preferred airline carriers."
        },
        "defaultCabinClass": {
          "type": "string",
          "enum": ["economy", "premium_economy", "business"],
          "description": "Default cabin class for searches."
        },
        "budgetAlertThresholdPercent": {
          "type": "number",
          "description": "Percentage price drop that triggers notification."
        },
        "inAppAlerts": {
          "type": "boolean",
          "description": "Whether in-app alerts are active."
        },
        "emailAlerts": {
          "type": "boolean",
          "description": "Whether email alerts are active."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "UI theme preference."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last update."
        }
      },
      "required": ["userId", "email", "homeAirport", "defaultCabinClass"]
    },
    "TrackedFlight": {
      "title": "TrackedFlight",
      "description": "Monitored flight itinerary with target price and price history.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique tracking record ID."
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID."
        },
        "origin": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Origin IATA code."
        },
        "destination": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Destination IATA code."
        },
        "departureDate": {
          "type": "string",
          "description": "Date of flight in YYYY-MM-DD format."
        },
        "targetPriceInr": {
          "type": "number",
          "description": "User target threshold in INR."
        },
        "currentLowestPriceInr": {
          "type": "number",
          "description": "Most recently observed lowest price in INR."
        },
        "currency": {
          "type": "string",
          "enum": ["INR"],
          "description": "Currency code."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether monitoring is currently active."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        },
        "lastCheckedAt": {
          "type": "string",
          "description": "Timestamp of most recent fare check."
        }
      },
      "required": ["id", "userId", "origin", "destination", "departureDate", "targetPriceInr", "isActive"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or price drop alert sent to a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notification ID."
        },
        "userId": {
          "type": "string",
          "description": "Recipient user UID."
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Notification headline."
        },
        "message": {
          "type": "string",
          "maxLength": 500,
          "description": "Notification body text."
        },
        "type": {
          "type": "string",
          "enum": ["PRICE_DROP", "TARGET_MET", "PREDICTION_UPDATE", "SYSTEM"],
          "description": "Category of alert."
        },
        "read": {
          "type": "boolean",
          "description": "Whether notification has been viewed."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp alert was emitted."
        }
      },
      "required": ["id", "userId", "title", "message", "type", "read", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profile and travel preferences document."
    },
    "/users/{userId}/trackedFlights/{trackedFlightId}": {
      "schema": { "$ref": "TrackedFlight" },
      "description": "User-specific tracked itineraries and price targets."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "Notification" },
      "description": "User-specific alert events and price drop logs."
    }
  }
}
